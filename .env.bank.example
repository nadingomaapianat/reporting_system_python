# =====================================================================
#  reporting_system_python - BANK (ADIB) environment template
# =====================================================================
#  Copy to `.env` on the bank server / in the project root before `docker build`.
#  NEVER commit the real `.env` or `environment.env` (they are git-ignored).
#  Values marked [SHARED] must be IDENTICAL in the other services listed.
#  Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

NODE_ENV=production
PORT=8000
RELOAD=false

# ---------- Database ----------
DB_BACKEND=pymssql                  # pymssql (NTLM, current default) or odbc
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=10.240.3.116                # bank SQL Server - confirm
DB_PORT=1433
DB_NAME=CHANGE_ME                   # same DB as adib_backend
DB_USE_WINDOWS_AUTH=1
DB_DOMAIN=ADIBEG
DB_USERNAME=CHANGE_ME               # least-privilege reporting login, NOT SA
DB_PASSWORD=CHANGE_ME               # [SECRET] rotate - old value was committed to git
DB_CONNECT_TIMEOUT=10
# empty / true = SQL Server certificate trusted without checking (current behaviour);
# false = verify it (install the bank CA first)
DB_TRUST_SERVER_CERT=

# ---------- Auth ----------
JWT_SECRET=CHANGE_ME                # [SECRET][SHARED with adib_backend + reporting_system_node] min 32 chars
# CSRF tokens are signed by the server. Leave empty = key derived from JWT_SECRET (recommended).
# A dedicated key goes ONLY in the server's real .env: min 32 chars, same value on every instance.
CSRF_SECRET=
REPORTING_SUPER_ADMIN_USER_IDS=
REPORTING_ALLOW_QUERY_TOKEN_AUTH=false   # tokens in URLs leak into logs
REPORTING_LOG_AUTH_HEADERS=false
REPORTING_DEBUG_COOKIES_ENDPOINT=false
REPORTING_DEBUG_LOG=false                # true = write debug_log.txt + stderr trace (never on servers)
REPORTING_PERMISSIONS_CACHE_SECONDS=60   # page permissions are re-read from the DB at most every N seconds

# ---------- URLs / CORS ----------
NODE_API_URL=https://grc-reporting-node-uat.adib.co.eg
NODE_BACKEND_URL=https://grc-reporting-node-uat.adib.co.eg
PYTHON_API_URL=https://grc-reporting-py-uat.adib.co.eg
PYTHON_API_BASE=https://grc-reporting-py-uat.adib.co.eg
FRONTEND_ORIGIN=https://grc-reporting-uat.adib.co.eg
CORS_ORIGINS=https://grc-reporting-uat.adib.co.eg,https://grc-dcc-uat.adib.co.eg
CSRF_COOKIE_SECURE=true
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1                # reverse proxies in front of the app that add X-Forwarded-For (nginx = 1)
UPLOAD_MAX_FILE_MB=50               # largest accepted upload
UPLOAD_MAX_UNZIPPED_MB=200          # docx/xlsx refused if they would unpack to more than this
UPLOAD_MAX_REQUEST_MB=100           # whole upload request, refused before it is read
UPLOAD_LIMIT_PER_HOUR=50            # file upload requests per user per hour (R-WAPT02)
UPLOAD_LIMIT_PER_DAY=100            # ... and per day
RATE_LIMIT_MAX=40                   # requests per IP per window
RATE_LIMIT_WINDOW_SECONDS=60
API_TIMEOUT=60

# ---------- TLS ----------
VERIFY_SSL=true                     # was false: keep true and give CERT_PATH the bank CA
CERT_PATH=./certs.pem

# ---------- Bank shown on exported reports (empty = not printed) ----------
# ADIB values (previously hardcoded in routes/dynamic_report_endpoints.py). Quoted: they contain spaces.
REPORT_TITLE="ADIB GRC Report"
REPORT_BANK_NAME="Abu Dhabi Islamic Bank Egypt"
REPORT_BANK_ADDRESS="Head Office: Corniche El Nil, Cairo, Egypt"
# Placeholder number carried over from the old source; replace with the bank's real number.
REPORT_BANK_PHONE="+20 2 1234 5678"
REPORT_BANK_WEBSITE="https://www.adib.eg"
# Default logo on PDF/Excel/Word exports when the user has not uploaded one (empty = no logo)
REPORT_LOGO_FILE=assets/logos/adib-logo.png

# ---------- OCR (only if used) ----------
OCR_WEBHOOK_URL=
TESSERACT_CMD=
TESS_LANG=
POPPLER_PATH=

# ---------- SIEM activity log ----------
# Every write, export and refused request is written to the shared Targets table (same DB).
# Empty / true = on; false = off. Needs INSERT on dbo.Targets for the DB login above (a failed insert is only logged).
SIEM_ACTIVITY_LOG=true

# ---------- Encrypted env (same procedure as the main backend) ----------
# On start the plain .env is encrypted to .env.enc and deleted; a .passcode file keeps the passcode hash.
# The passcode is typed at the prompt (docker exec -it ... / docker run -it), or given ONLY in the
# container environment as ENV_PASSCODE for a start without a terminal. Never put it in this file.
# ENV_PASSCODE=
