# =====================================================================
#  reporting_system_python - BANK (ADIB) environment template
# =====================================================================
#  Copy to `.env` on the bank server / in the project root before `docker build`.
#  NEVER commit the real `.env` or `environment.env` (they are git-ignored).
#  Values marked [SHARED] must be IDENTICAL in the other services listed.
#  Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

NODE_ENV=production
PORT=8000
RELOAD=false

# ---------- Database ----------
DB_BACKEND=pymssql                  # pymssql (NTLM, current default) or odbc
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=10.240.3.116                # bank SQL Server - confirm
DB_PORT=1433
DB_NAME=CHANGE_ME                   # same DB as adib_backend
DB_USE_WINDOWS_AUTH=1
DB_DOMAIN=ADIBEG
DB_USERNAME=CHANGE_ME               # least-privilege reporting login, NOT SA
DB_PASSWORD=CHANGE_ME               # [SECRET] rotate - old value was committed to git
DB_CONNECT_TIMEOUT=10

# ---------- Auth ----------
JWT_SECRET=CHANGE_ME                # [SECRET][SHARED with adib_backend + reporting_system_node] min 32 chars
REPORTING_SUPER_ADMIN_USER_IDS=
REPORTING_ALLOW_QUERY_TOKEN_AUTH=false   # tokens in URLs leak into logs
REPORTING_LOG_AUTH_HEADERS=false
REPORTING_DEBUG_COOKIES_ENDPOINT=false

# ---------- URLs / CORS ----------
NODE_API_URL=https://grc-reporting-node-uat.adib.co.eg
NODE_BACKEND_URL=https://grc-reporting-node-uat.adib.co.eg
PYTHON_API_URL=https://grc-reporting-py-uat.adib.co.eg
PYTHON_API_BASE=https://grc-reporting-py-uat.adib.co.eg
FRONTEND_ORIGIN=https://grc-reporting-uat.adib.co.eg
CORS_ORIGINS=https://grc-reporting-uat.adib.co.eg,https://grc-dcc-uat.adib.co.eg
CSRF_COOKIE_SECURE=true
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1                # reverse proxies in front of the app that add X-Forwarded-For (nginx = 1)
UPLOAD_MAX_FILE_MB=50               # largest accepted upload
UPLOAD_MAX_UNZIPPED_MB=200          # docx/xlsx refused if they would unpack to more than this
UPLOAD_MAX_REQUEST_MB=100           # whole upload request, refused before it is read
UPLOAD_LIMIT_PER_HOUR=50            # file upload requests per user per hour (R-WAPT02)
UPLOAD_LIMIT_PER_DAY=100            # ... and per day
RATE_LIMIT_MAX=40                   # requests per IP per window
RATE_LIMIT_WINDOW_SECONDS=60
API_TIMEOUT=60

# ---------- TLS ----------
VERIFY_SSL=true                     # was false: keep true and give CERT_PATH the bank CA
CERT_PATH=./certs.pem

# ---------- OCR (only if used) ----------
OCR_WEBHOOK_URL=
TESSERACT_CMD=
TESS_LANG=
POPPLER_PATH=
