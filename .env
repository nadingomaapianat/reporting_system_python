# Backend API Configuration
# Set this to your Node.js backend URLt.ai

NODE_BACKEND_URL=https://backendnode-adib-reporting.pianat.ai

# API Configuration
NODE_API_URL=https://backendnode-adib-reporting.pianat.ai
PYTHON_API_URL=https://backendpython-adib-reporting.pianat.ai
API_TIMEOUT=60

# Database Configuration (use DB_HOST or DB_SERVER)
# Windows Authentication: domain\user + password (NTLM); or Trusted_Connection with DB_BACKEND=odbc
DB_SERVER=206.189.57.0
DB_PORT=1433
DB_NAME=NEWDCC-V4-UAT
DB_DRIVER=ODBC Driver 18 for SQL Server

# SQL Server Authentication (plain username/password - works from non-domain-joined machines).
# The code actually reads DB_USE_SQL_AUTH (DB_USE_WINDOWS_AUTH above is not read by config/settings.py).
DB_USE_SQL_AUTH=yes
DB_DOMAIN=
DB_USERNAME=SA
DB_PASSWORD=Nothing_159

# Connection Settings
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_REQUEST_TIMEOUT=60000
# Python: timeout in seconds (fail fast when DB unreachable; default 10 to avoid 504)
DB_CONNECT_TIMEOUT=10

# Connection Pool Settings (similar to NestJS)
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000

CORS_ORIGINS=https://dcc-adib.pianat.ai,https://backendnode-adib-reporting.pianat.ai
FRONTEND_ORIGIN=https://dcc-adib.pianat.ai/reporting/
