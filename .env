# Node backend URL (reporting_system_node)



PYTHON_API_BASE=https://grc-reporting-py.adib.co.eg




# OCR webhook (e.g. n8n) for bank check
OCR_WEBHOOK_URL=

CSRF_COOKIE_SECURE=true
TRUST_PROXY=true
VERIFY_SSL=false
CERT_PATH=./certs.pem
JWT_SECRET=GRC_ADIB_2025
# API timeout (seconds)
NODE_BACKEND_URL=https://backendnode-adib-reporting.pianat.ai

# API Configuration
NODE_API_URL=https://backendnode-adib-reporting.pianat.ai
PYTHON_API_URL=https://backendpython-adib-reporting.pianat.ai
API_TIMEOUT=60


NODE_ENV=production





DB_HOST=10.240.3.116
DB_PORT=1433
DB_NAME=NEWDCC-V4-UAT
DB_DRIVER=ODBC Driver 18 for SQL Server

# SQL Server Authentication (plain username/password - works from non-domain-joined machines).
# The code actually reads DB_USE_SQL_AUTH (DB_USE_WINDOWS_AUTH above is not read by config/settings.py).
DB_USE_SQL_AUTH=yes
DB_DOMAIN=
DB_USERNAME=SA
DB_PASSWORD=Nothing_159

# Connection Settings
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_REQUEST_TIMEOUT=60000
# Python: timeout in seconds (fail fast when DB unreachable; default 10 to avoid 504)
DB_CONNECT_TIMEOUT=10


# Debug auth/cookies during migration (disable after validation).
REPORTING_LOG_AUTH_HEADERS=true
REPORTING_DEBUG_COOKIES_ENDPOINT=true

CORS_ORIGINS=https://dcc-adib.pianat.ai,https://adib-demo-reporting.pianat.ai,https://backendnode-adib-reporting.pianat.ai
FRONTEND_ORIGIN=https://adib-demo-reporting.pianat.ai
