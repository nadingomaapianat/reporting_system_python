# =============================================================================
# reporting_system_python — example of environment.env (Docker)
# Every key the service reads, with the current non-secret values so they can be
# remembered. Secrets are placeholders: the real ones live only on the server.
# On start the service encrypts the real file to <name>.enc and deletes it
# (passcode typed at the prompt, or ENV_PASSCODE).
# =============================================================================

NODE_API_URL=https://dcc-reporting-api-node.theubeg.ub.dom
NODE_BACKEND_URL=https://dcc-reporting-api-node.theubeg.ub.dom
PYTHON_API_URL=https://dcc-reporting-api-py.theubeg.ub.dom
PYTHON_API_BASE=https://dcc-reporting-api-py.theubeg.ub.dom
CORS_ORIGINS=https://dcc-reporting.theubeg.ub.dom,https://dcc-grc.theubeg.ub.dom,https://dcc-reporting-api-node.theubeg.ub.dom
FRONTEND_ORIGIN=https://dcc-reporting.theubeg.ub.dom
OCR_WEBHOOK_URL=https://n8nio.pianat.ai/webhook/ocr-check
API_TIMEOUT=60
DB_BACKEND=pymssql
DB_HOST=206.189.57.0
DB_PORT=1433
DB_NAME=GRCDB
DB_USE_WINDOWS_AUTH=0
DB_DOMAIN=ADIBEG
DB_USERNAME=SA
DB_PASSWORD=<set-on-server>
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_CONNECT_TIMEOUT=10
NODE_ENV=production
CSRF_COOKIE_SECURE=true
TRUST_PROXY=true
CERT_PATH=./certs.pem
