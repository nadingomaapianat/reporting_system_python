# Reporting Python – links and API bases (copy to .env or use this file)
# Node backend URL (reporting_system_node)
NODE_API_URL=http://localhost:3002
NODE_BACKEND_URL=http://localhost:3002

# This service (Python) base URL – used when Python calls itself or is referenced
PYTHON_API_URL=http://localhost:8000
PYTHON_API_BASE=http://localhost:8000

# CORS: comma-separated origins allowed to call this API (or set FRONTEND_ORIGIN for single)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# OCR webhook (e.g. n8n) for bank check
OCR_WEBHOOK_URL=https://n8nio.pianat.ai/webhook/ocr-check

# API timeout (seconds)
API_TIMEOUT=60

# Optional: PORT=8000, RELOAD=1, CSRF_COOKIE_SECURE=false

# Database – same as adib_backend .env (NTLM via pymssql, no ODBC).
# Use DB_HOST or DB_SERVER. Windows auth: DB_USE_WINDOWS_AUTH=1 + DB_DOMAIN + DB_USERNAME + DB_PASSWORD.
DB_BACKEND=pymssql
DB_HOST=206.189.57.0
DB_SERVER=206.189.57.0
DB_PORT=1433
DB_NAME=NEWDCC-V4-UAT
DB_USE_WINDOWS_AUTH=0

DB_USERNAME=SA
DB_PASSWORD=Nothing_159
DB_DRIVER=ODBC Driver 18 for SQL Server
# Connection timeout (seconds); fail fast when DB unreachable to avoid 504
DB_CONNECT_TIMEOUT=10
