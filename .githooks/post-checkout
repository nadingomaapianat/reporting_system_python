#!/bin/sh
# After switching branches: scan the files that changed between the old and new branch.
# $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout (0 for a single-file checkout).
[ "$3" = "1" ] || exit 0
case "$1" in
  0000000000000000000000000000000000000000) exec sh scripts/malware-check.sh ;;  # fresh clone
esac
exec sh scripts/malware-check.sh --changed "$1" "$2"
