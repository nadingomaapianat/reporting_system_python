# =============================================================================
# reporting_system_python — copy values into .env or environment.env
# Never commit real .env with secrets.
# =============================================================================

# --- Node (reporting_system_node) ---
NODE_API_URL=https://dcc-reporting-api-node.theubeg.ub.dom
NODE_BACKEND_URL=https://dcc-reporting-api-node.theubeg.ub.dom

# --- This service (Python) public URL (browser CORS + links) ---
PYTHON_API_URL=https://dcc-reporting-api-py.theubeg.ub.dom
PYTHON_API_BASE=https://dcc-reporting-api-py.theubeg.ub.dom

# --- CORS (browser direct calls with credentials) — list every frontend origin ---
CORS_ORIGINS=https://dcc-reporting.theubeg.ub.dom,https://dcc-grc.theubeg.ub.dom,https://dcc-reporting-api-node.theubeg.ub.dom
FRONTEND_ORIGIN=https://dcc-reporting.theubeg.ub.dom

# --- JWT (must match reporting_system_node JWT_SECRET) ---
JWT_SECRET=<set-on-server>

# --- Admin / function scoping (same rules as Node UserFunctionAccessService.isAdmin) ---
# Optional: comma-separated user IDs that see all functions (like Node REPORTING_SUPER_ADMIN_USER_IDS).
# REPORTING_SUPER_ADMIN_USER_IDS=

# UAT only: if UserFunction has 0 rows for this user, skip function filter (do NOT set true in production).
# Usually leave unset: UserFunction is loaded via SQL; ensure list params use tuple (see utils/pymssql_params.py).
# REPORTING_ALLOW_ALL_WHEN_NO_USER_FUNCTIONS=false

# --- CSRF ---
CSRF_COOKIE_SECURE=true
# Optional: lax | strict | none (none requires CSRF_COOKIE_SECURE=true)
# CSRF_COOKIE_SAMESITE=lax

# --- Misc ---
API_TIMEOUT=60
TRUST_PROXY=true
CERT_PATH=./certs.pem
NODE_ENV=production

# TLS for outbound HTTPS from Python
VERIFY_SSL=true

# --- Optional debug (disable in production) ---
# REPORTING_LOG_AUTH_HEADERS=true
# REPORTING_DEBUG_COOKIES_ENDPOINT=true

# --- Optional integrations ---
# OCR_WEBHOOK_URL=https://n8nio.pianat.ai/webhook/ocr-check

# --- Database — MUST match reporting_system_node (same GRC data as the UI) ---
# DB_HOST or DB_SERVER, DB_PORT, DB_NAME, credentials — copy from Node .env for exports to match dashboard.
# DB_CONNECT_TIMEOUT=10

# --- Also in the current .env (non-secret values kept, secrets are placeholders) ---
OCR_WEBHOOK_URL=
DB_HOST=10.240.3.116
DB_PORT=1433
DB_NAME=NEWDCC-V2-UAT
DB_USE_WINDOWS_AUTH=0
DB_DOMAIN=ADIBEG
DB_USERNAME=GRCSVC
DB_PASSWORD=<set-on-server>
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_CONNECT_TIMEOUT=10
REPORTING_LOG_AUTH_HEADERS=true
REPORTING_DEBUG_COOKIES_ENDPOINT=true

# --- Report builder: data never offered (defaults shown; comma-separated) ---
# REPORTING_BLOCKED_TABLES=blocked_tokens,iframe_entry_tokens,integration_settings,Targets
# REPORTING_BLOCKED_COLUMNS=Users.password,Users.currentToken,Groups.permissions
